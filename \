from src.account import Account
import requests


class CompanyAccount(Account):
    def __init__(self, company_name, NIP):
        super().__init__()
        self.company_name = company_name
        self.NIP = self.set_NIP(NIP)
        if self.NIP == "Unregistered":
            raise ValueError("Company not registered!!")
        self.balance = 0.0

    def set_NIP(self, NIP):
        if len(NIP) != 10:
            return "Invalid"
        if not self.check_NIP(NIP):
            return "Unregistered"
        return NIP

    def make_express_transfer(self, amount, transferAccount):
        super().make_express_transfer(amount, transferAccount, 5)

    def take_loan(self, amount):
        if self.balance >= 2 * amount:
            for transaction in self.history:
                if transaction == -1775:
                    return True
        return False

    def check_NIP(self, NIP):
        url = f"https://wl-api.mf.gov.pl/api/search/nip/{NIP}?date=2025-12-01"
        response = requests.get(url)

        status = response.status_code
        if status_code != 200:
            print("Konto nie istnieje")
            return False

        data = response.json()
        if data["statusVat"] != "Czynny":
            print("Konto nieczynne")
            return False
        print("Konto czynne")
        return True
